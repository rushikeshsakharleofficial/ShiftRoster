# ── ShiftRoster Environment Variables ──
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── MongoDB ──
MONGO_USER=shiftroster
MONGO_PASSWORD=change_me_strong_password

# ── Application ──
JWT_SECRET=change_me_64char_hex_secret
MSG_ENCRYPT_KEY=change_me_fernet_key   # generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Cookies ──
# Set true only when serving over HTTPS. Keep false for HTTP (e.g. local/IP access).
SECURE_COOKIES=false

# ── Domain / TLS ──
DOMAIN=localhost
PROTOCOL=http                          # set to https when using SSL certs

# ── CORS (optional) ──
# Comma-separated list of allowed origins. Defaults to localhost if unset.
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── GitHub Actions runner (optional) ──
# Required only if using the self-hosted runner container.
# PAT needs repo scope: github.com → Settings → Developer Settings → Personal Access Tokens
# GITHUB_PAT=github_pat_xxxxxxxxxxxx
